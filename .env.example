# Copy to .env (git-ignored) and adjust. Everything has a working default for local development.
# Local-only token for the dev reveal/attempt routes: 16-128 visible ASCII characters. Never reuse a real secret.
PANELPROOF_REVEAL_TOKEN=local-dev-token-0123
# Axum API instances the web server proxies to (loopback only)
PP_API_DEMO=http://127.0.0.1:3001
PP_API_FACTORY=http://127.0.0.1:3002
# Task Factory worker (all optional)
PP_PYTHON=python
PP_MAX_GENERATE_COUNT=4
PP_JOB_DEADLINE_SECS=120
# Windows without a native Rust toolchain: run the Linux API in WSL
# PP_API_WSL_DISTRO=Ubuntu-22.04
# PP_API_BIN=/home/you/pp-rust/target/debug/panelproof-api
# No credentials are needed for the offline demo. Live model keys, if ever added, belong only in .env.
